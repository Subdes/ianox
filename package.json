{
  "name": "ianox",
  "private": true,
  "version": "0.0.4",
  "description": "ianox — local AI gateway, model manager and coding agent for the desktop (pre-alpha)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json --threshold error && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build",
    "build:win": "tauri build --target x86_64-pc-windows-gnu",
    "build:mac": "PATH=\"$PWD/.bin:$PATH\" SDKROOT=\"$HOME/MacOSX-SDK/MacOSX11.3.sdk\" cargo zigbuild --manifest-path src-tauri/Cargo.toml --target x86_64-apple-darwin --release",
    "build:all": "npm run build:app && npm run build:win && npm run build:mac && ./scripts/bundle-dmg.sh && ./scripts/bundle-msi.sh && ./scripts/bundle-flatpak.sh && ./scripts/collect-packages.sh",
    "bundle:dmg": "./scripts/bundle-dmg.sh",
    "bundle:msi": "./scripts/bundle-msi.sh",
    "bundle:flatpak": "./scripts/bundle-flatpak.sh",
    "collect": "./scripts/collect-packages.sh",
    "icons": "node scripts/gen-icon.mjs && tauri icon src-tauri/icons/source.png",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.12.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "license": "MIT",
  "author": "Subdes",
  "homepage": "https://github.com/Subdes/ianox",
  "repository": {
    "type": "git",
    "url": "https://github.com/Subdes/ianox.git"
  },
  "bugs": {
    "url": "https://github.com/Subdes/ianox/issues"
  }
}
